# Copia este ficheiro para .env e preenche com valores reais.

# Ligação ao PostgreSQL.
DATABASE_URL="postgresql://user:password@localhost:5432/konta_dev?schema=public"

# Segredo usado para assinar os tokens de sessão (JWT). Gera um valor longo e
# aleatório, por exemplo com: openssl rand -base64 48
# NUNCA reutilizes o valor de desenvolvimento em produção.
AUTH_SECRET="troca-me-por-um-valor-aleatorio-longo"

# [Opcional — painel de estatísticas do dono do projeto, ver
# src/lib/auth/admin.ts] Lista de emails separados por vírgula que veem a
# página /admin (Estatísticas). Sem esta variável definida, ninguém a vê —
# fail-closed por omissão, mesmo em desenvolvimento.
# ADMIN_EMAILS="teu-email@exemplo.com"

# [Konta AI — Milestone 1] Chave da API da Anthropic, usada só em
# src/lib/ai/gateway.ts (nunca exposta ao browser). Sem esta variável, o
# endpoint POST /api/ai/chat responde 503 em vez de falhar sem explicação.
# NUNCA commitar uma chave real — só este placeholder no ficheiro .example.
ANTHROPIC_API_KEY="sk-ant-troca-me-pela-tua-chave"
