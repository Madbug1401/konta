# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# [Correção — Pre-Beta Hardening, Prioridade 12] os *.example são modelos
# sem segredos reais e têm de ficar no repositório — sem isto, "npm run
# build"/deploy num checkout novo nem tinha o ficheiro de onde copiar as
# variáveis. Os .env/.env.production reais continuam ignorados acima.
!.env.example
!.env.production.example
!.env.render.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# [Correção — preparação do repositório GitHub] backups/dumps reais nunca
# devem ir para o Git — contêm dados financeiros dos utilizadores (ver
# docs/architecture/BACKUP.md e scripts/backup/*.sh, que escrevem aqui por
# omissão).
backups/
*.dump
*.sql.gz

# logs locais
logs/
*.log

# ficheiros de sistema (desenvolvimento em Windows)
Thumbs.db
desktop.ini

# [Correção — preparação do repositório GitHub] script de demonstração de
# screenshots: tem caminhos absolutos deste sandbox de desenvolvimento
# (não portável para outra máquina) e existe só para gerar as imagens em
# screenshots/, que também não fazem parte do produto nem são necessárias
# para correr/fazer deploy do Konta.
scripts/screenshot-demo.mjs
screenshots/
