# ============================================================================
# Modelo de variáveis de ambiente para o caminho de deploy ZERO-COST
# (Render + Neon) — ver docs/operations/RENDER-NEON.md e
# docs/ZERO_COST_DEPLOYMENT_AUDIT.md.
#
# Diferente de `.env.production.example`: aquele é para o caminho Docker
# Compose completo (Postgres + Caddy próprios, pensado para a Oracle Cloud
# ou qualquer VPS — ver docs/operations/ORACLE-CLOUD.md). Este ficheiro é
# mais pequeno de propósito: no caminho Render+Neon não há container de
# Postgres nosso (é o Neon, gerido) nem reverse proxy nosso (o Render já
# dá HTTPS gerido) — só a app em si precisa de variáveis.
#
# Não copiar para `.env` neste repositório — estas variáveis vão diretamente
# para o painel de "Environment" do serviço no Render (ou para o campo
# `envVars` do render.yaml, sem valores reais nele — ver esse ficheiro).
# NUNCA commitar valores reais.
# ============================================================================

# Connection string completa do Neon (painel do Neon → Connection Details).
# Já vem no formato que a app espera, incluindo "?sslmode=require" — não é
# preciso editar nada, só copiar/colar. Confirma que aponta para a base de
# dados de PRODUÇÃO (não uma branch de desenvolvimento do Neon), se tiveres
# mais do que uma.
DATABASE_URL=postgresql://troca-me:troca-me@troca-me.neon.tech/konta?sslmode=require

# Segredo dos tokens de sessão (JWT). Gera com: openssl rand -base64 48
# Diferente do valor de desenvolvimento e diferente de qualquer valor usado
# no caminho Oracle/.env.production, se algum dia correres os dois em
# paralelo. Mudar isto invalida todas as sessões ativas (aceitável).
AUTH_SECRET=troca-me-por-um-valor-aleatorio-longo-e-unico

# Liga o cookie de sessão como "secure" (exige HTTPS) — o Render já serve
# tudo em HTTPS por omissão em *.onrender.com, por isso isto é seguro
# deixar sempre "production" nesta plataforma.
NODE_ENV=production

# [Opcional — painel de estatísticas do dono do projeto, ver
# src/lib/auth/admin.ts] Lista de emails separados por vírgula que veem a
# página /admin (Estatísticas) e a entrada "Estatísticas" na navegação.
# Sem esta variável definida no painel do Render, a página devolve 404 para
# toda a gente (fail-closed) — usa o teu próprio email de login do Konta.
ADMIN_EMAILS=troca-me-pelo-teu-email@exemplo.com
